                            <!-- JS Populated -->
                        </div>
                    </div>

                    <!-- RIGHT: CREATE -->
                    <div style="width: 300px; padding-left: 20px;">
                        <h3 style="color: #00ff00; font-size: 12px; margin-bottom: 15px;">UTWORZ NOWY:</h3>

                        <div style="margin-bottom: 10px;">
                            <label style="font-size: 10px;">NAZWA:</label><br>
                            <input id="newProfileName" type="text" maxlength="12"
