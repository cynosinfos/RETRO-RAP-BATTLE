                });
            </script>

            <!-- Intro Styles & Script -->
            <style>
                .graffiti-logo {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 0px;
                    transform: rotate(-5deg);
                    /* Slight graffiti tilt */
                }

                .graffiti-line {
                    font-family: 'Permanent Marker', cursive;
                    font-size: 100px;
                    /* Bigger size */
                    line-height: 0.9;
                }

                .neon-blue {
                    color: #00ffff;
                    text-shadow: 4px 4px 0px #000, 8px 8px 0px #008b8b;
                }

                .neon-pink {
                    color: #ff0055;
                    text-shadow: 4px 4px 0px #000, 8px 8px 0px #8b0000;
                    margin-left: 40px;
                    /* Slanted alignment effect */
                }

                .neon-green {
                    color: #00ff00;
                    text-shadow: 4px 4px 0px #000, 8px 8px 0px #006400;
                    margin-left: -20px;
                }

                .neon-text {
                    text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #00ffff, 0 0 30px #00ffff, 0 0 40px #00ffff;
                    animation: flicker 2s infinite alternate;
                }

                .neon-text-pink {
                    text-shadow: 0 0 5px #fff, 0 0 10px #fff, 0 0 20px #ff0055, 0 0 30px #ff0055, 0 0 40px #ff0055;
                    animation: flicker 2.5s infinite alternate;
                }

                @keyframes flicker {

                    0%,
