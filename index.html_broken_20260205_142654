                function updateProfileDisplay() {
                    if (window.collectionManager) {
                        const current = window.collectionManager.currentProfile;
                        document.getElementById('profileDisplay').innerText = `PROFIL: ${current.toUpperCase()}`;

                        // If Admin, change color logic
                        const isAdmin = window.collectionManager.collection.isAdmin;
                        if (isAdmin) {
                            document.getElementById('profileDisplay').style.borderColor = '#ff0055';
                            document.getElementById('profileDisplay').style.color = '#ff0055';
                        } else {
                            document.getElementById('profileDisplay').style.borderColor = '#555';
                            document.getElementById('profileDisplay').style.color = 'white';
                        }
                    }
                }

                function openProfileModal() {
                    if (!window.collectionManager) return;
                    document.getElementById('profileModal').style.display = 'flex';
                    renderProfileList();
                }

                function renderProfileList() {
                    const list = document.getElementById('profileList');
                    list.innerHTML = '';

                    const profiles = window.collectionManager.getProfiles();
                    const current = window.collectionManager.currentProfile;

                    profiles.forEach(p => {
                        const div = document.createElement('div');
                        div.style.padding = '10px';
                        div.style.border = '1px solid #444';
                        div.style.cursor = 'pointer';
                        div.style.backgroundColor = (p === current) ? '#333' : 'transparent';
                        div.style.color = (p === current) ? '#00ff00' : '#aaa';
                        div.innerText = p.toUpperCase();

                        if (p !== current) {
                            div.onmouseover = () => div.style.backgroundColor = '#222';
                            div.onmouseout = () => div.style.backgroundColor = 'transparent';
                            div.onclick = () => switchProfileUI(p);
                        }

                        list.appendChild(div);
                    });
                }

                function switchProfileUI(name) {
                    window.collectionManager.switchProfile(name);
                    updateProfileDisplay();
                    renderProfileList();
                    // Reload Page to refresh all systems safely
                    setTimeout(() => location.reload(), 500);
                }

                function toggleAdminPass() {
                    const chk = document.getElementById('adminCheckbox');
                    document.getElementById('adminPassField').style.display = chk.checked ? 'block' : 'none';
                }

                function createNewProfileUI() {
                    const name = document.getElementById('newProfileName').value.trim();
                    const isAdmin = document.getElementById('adminCheckbox').checked;
                    const pass = document.getElementById('adminPassInput').value;

                    if (!name) return alert("PODAJ NAZWE PROFILU!");
                    if (isAdmin && pass !== 'admin') return alert("ZLE HASLO ADMINA!"); // Simple pass: 'admin'

                    const success = window.collectionManager.createProfile(name, isAdmin);
                    if (!success) {
                        alert("PROFIL O TEJ NAZWIE JUZ ISTNIEJE!");
                    } else {
                        alert("PROFIL UTWORZONY!");
                        switchProfileUI(name);
                    }
                }

                // Init Display on Load
                window.addEventListener('load', () => {
                    setTimeout(updateProfileDisplay, 1000); // Wait for scripts
                });
            </script>


