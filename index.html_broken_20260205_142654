                function switchView(viewName) {
                    document.getElementById('viewNews').style.display = 'none';
                    document.getElementById('viewMap').style.display = 'none';
                    document.getElementById('viewCity').style.display = 'none';

                    document.getElementById('view' + viewName).style.display = 'block';
                }

                function showMap() {
                    switchView('Map');
                    renderMapPins();
                    updateMapUI();
                }

                function updateMapUI() {
                    if (window.collectionManager) {
                        document.getElementById('mapStamina').innerText = window.collectionManager.getStamina();
                        const cur = window.collectionManager.collection.currentCity || 'WWA';
                        document.getElementById('mapLocation').innerText = cur;
                        document.getElementById('mapLocation').style.color = '#00ffff';
                    }
                }

                function renderMapPins() {
                    const container = document.getElementById('mapContainer');
                    container.innerHTML = ''; // Clear

                    const current = window.collectionManager.collection.currentCity || 'WWA';

                    CITIES.forEach(city => {
                        const pin = document.createElement('div');
                        pin.style.position = 'absolute';
                        pin.style.left = city.x + '%';
                        pin.style.top = city.y + '%';
                        pin.style.transform = 'translate(-50%, -50%)';
                        pin.style.cursor = 'pointer';
                        pin.style.textAlign = 'center';
                        pin.onclick = () => handleCityClick(city);

                        const isCurrent = city.id === current;
                        const color = isCurrent ? '#00ff00' : '#ff0055';
                        const size = isCurrent ? '30px' : '20px';

                        pin.innerHTML = `
                    <div style="font-size: ${size}; filter: drop-shadow(0 0 5px black);">📍</div>
                    <div style="background: rgba(0,0,0,0.7); color: ${color}; font-size: 8px; padding: 2px; border: 1px solid ${color}; margin-top: 2px;">
                        ${city.id}
                    </div>
                `;
                        container.appendChild(pin);
                    });
                }

                function handleCityClick(city) {
                    const current = window.collectionManager.collection.currentCity || 'WWA';

                    if (city.id === current) {
                        // Determine background based on City
                        // For now, only Warsaw has asset, others generic or same
                        if (city.id !== 'WWA') {
                            // Alert prototype
                            // But we proceed to City View anyway using generic background
                            // Or keep Warsaw BG for all for now
                            // alert("Wizualizacja miasta w budowie. Używam makiety WWA.");
                        }
                        switchView('City');
                    } else {
                        // Travels
                        if (confirm(`Czy chcesz pojechać do: ${city.name}? (KOSZT: 200 MK, 20 Stamina)`)) {
                            attemptTravel(city);
                        }
                    }
                }

                function attemptTravel(city) {
                    const cm = window.collectionManager;
                    const costMoney = 200;
                    const costStamina = 20;

                    if (cm.getMoney() < costMoney) return alert("BRAK Siana!");
                    if (cm.getStamina() < costStamina) return alert("BRAK SIŁY!");

                    cm.updateMoney(-costMoney);
                    cm.updateStamina(-costStamina);
                    cm.collection.currentCity = city.id;
                    cm.saveCollection();

                    alert(`Dojechałeś do: ${city.name}!`);
                    showMap(); // Refresh pins
                }

                function restoreStamina() {
                    if (confirm("Czy chcesz odpocząć w Hotelu? (Koszt: 100 MK, +50 Stamina)")) {
                        const cm = window.collectionManager;
                        if (cm.getMoney() >= 100) {
                            cm.updateMoney(-100);
                            cm.updateStamina(50);
                            alert("Wypoczęty!");
                            updateMapUI();
                        } else {
                            alert("Brak hajsu na hotel!");
                        }
                    }
                }
            </script>

