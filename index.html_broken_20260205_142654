            <script>
                // AUTH STATE
                let authMode = null; // 'login' or 'register'

                // RESTORED Generic Click Event
                document.getElementById('introScreen').addEventListener('click', (e) => {
                    // Ignore if clicking buttons or modal (already handled by stopPropagation, but double check)
                    if (e.target.closest('.auth-btn') || e.target.closest('#authModal')) return;

                    // Enter as Guest
                    enterGame(null);
                });

                function showLoginModal() {
                    authMode = 'login';
                    document.getElementById('authTitle').innerText = "LOGIN";
                    document.getElementById('authTitle').style.color = "#00ff00";
                    document.getElementById('authModal').style.display = 'flex';
                    document.getElementById('authWarn').style.display = 'none';
                }

                function showRegisterModal() {
                    authMode = 'register';
                    document.getElementById('authTitle').innerText = "REGISTER";
                    document.getElementById('authTitle').style.color = "#ff0055";
                    document.getElementById('authModal').style.display = 'flex';
                    document.getElementById('authWarn').style.display = 'none';
                }

                function closeAuthModal() {
                    document.getElementById('authModal').style.display = 'none';
                }

                function handleAuthSubmit() {
                    const login = document.getElementById('authLogin').value.trim();
                    const pass = document.getElementById('authPass').value.trim();
                    const warn = document.getElementById('authWarn');

                    if (!login || !pass) {
                        warn.innerText = "WPISZ LOGIN I HASLO!";
                        warn.style.display = 'block';
                        return;
                    }

                    // SIMULATE AUTH
                    if (authMode === 'register') {
                        localStorage.setItem('user_' + login, pass);
                    } else {
                        // Check
                        /*
                        const saved = localStorage.getItem('user_' + login);
                        if (saved !== pass) {
                            warn.innerText = "BLEDNE DANE!";
                            warn.style.display = 'block';
                            return;
                        }
                        */
                        // Allow any login for prototyping unless strictly required
                    }

                    // SUCCESS
                    closeAuthModal();
                    enterGame(login);
                }

                // GLOBAL MENU HANDLER
                window.showMainMenu = function () {
                    console.log("SHOWING MAIN MENU (Guest Mode)");
                    // Hide other screens
                    document.getElementById('introScreen').style.display = 'none';
                    document.getElementById('playerMenuScreen').style.display = 'none';
                    document.getElementById('menuScreen').style.display = 'none'; // Character Select
                    document.getElementById('mapSelectionScreen').style.display = 'none';

                    // Show Main Menu
                    const mm = document.getElementById('mainMenuScreen');
                    if (mm) {
                        mm.style.display = 'flex';
                        mm.style.zIndex = '1000'; // High Z-Index

                        // Signal Main JS
                        if (typeof window.mainMenuActive !== 'undefined') {
                            window.mainMenuActive = true;
                            window.gameStarted = false;
                            window.isRoundActive = false;
                        }
                    } else {
                        console.error("Main Menu Screen not found in DOM");
                    }
                };

                function enterGame(username) {
                    if (username) {
                        console.log("Logged in as:", username);
                        window.currentUser = username;
                        localStorage.setItem('rrb_session_user', username); // [NEW] Session Persistence

                        // Initialize player data
                        if (!window.playerData) {
                            window.playerData = {
                                nick: username,
                                money: 2000,
                                respect: 0,
                                stamina: 100,
                                currentCity: 'WAW' // Ensure city is set
                            };
                        }

                        // Show Player Menu (RPG World)
                        const intro = document.getElementById('introScreen');
                        const menuScreen = document.getElementById('menuScreen'); // GUEST MENU

                        // DISABLE CRT EFFECT
                        document.body.classList.add('no-crt');

                        intro.style.transition = 'opacity 1s';
                        intro.style.opacity = '0';

                        // Immediate hiding of conflicting menus
                        if (menuScreen) menuScreen.style.display = 'none';
                        const mainMenu = document.getElementById('mainMenuScreen');
                        if (mainMenu) mainMenu.style.display = 'none';

                        setTimeout(() => {
                            intro.style.display = 'none';
                            showPlayerMenu();
                        }, 1000);
                    } else {
                        // ... Guest mode ...
                        enterGuestMode();
                    }
                }

                // Helper for Guest Mode (Refactored for clarity)
                function enterGuestMode() {
                    console.log("Entering Guest Mode");
                    // Ensure Player Menu is hidden
                    document.getElementById('playerMenuScreen').style.display = 'none';

                    const intro = document.getElementById('introScreen');
                    intro.style.transition = 'opacity 1s';
                    intro.style.opacity = '0';

                    setTimeout(() => {
                        intro.style.display = 'none';
                        window.showMainMenu(); // Now guaranteed to exist
                    }, 1000);
                }

                function showPlayerMenu() {
                    console.log("Showing Player Dashboard");
                    // Hide all screens explicitly
                    const mainMenu = document.getElementById('mainMenuScreen');
                    const menuScreen = document.getElementById('menuScreen');

                    if (mainMenu) mainMenu.style.display = 'none';
                    if (menuScreen) menuScreen.style.display = 'none';
                    document.getElementById('introScreen').style.display = 'none';

                    // Show player menu
                    const pm = document.getElementById('playerMenuScreen');
                    pm.style.display = 'block';
                    pm.style.zIndex = '200'; // Force top

                    // Restore body scroll if needed (though usually hidden)
                    document.body.style.overflow = 'hidden';
                    document.body.classList.add('no-crt');

                    // Update UI with player data
                    if (window.playerData) {
                        document.getElementById('playerNick').innerText = window.playerData.nick;
                        document.getElementById('playerMoney').innerText = window.playerData.money + ' MK';
                    }
                }

                // Player Menu Action Handlers
                function quickFight() {
                    console.log("Quick Fight clicked");
                    // Route to character select -> fight
                    if (window.showMainMenu) {
                        document.getElementById('playerMenuScreen').style.display = 'none';
                        window.showMainMenu();
                    }
                }

                function openInventory() {
                    window.location.href = 'inventory.html';
                }

                function openStats() {
                    window.location.href = 'stats.html';
                }

                // Return to Intro (for logout)
                function returnToMainMenu() {
                    console.log("Returning to Intro Screen");

                    // Hide all game screens
                    document.getElementById('playerMenuScreen').style.display = 'none';
                    document.getElementById('mainMenuScreen').style.display = 'none';
                    document.getElementById('menuScreen').style.display = 'none';

                    // Clear session
                    localStorage.removeItem('rrb_session_user');
                    window.currentUser = null;
                    window.playerData = null;

                    // Re-enable CRT effect
                    document.body.classList.remove('no-crt');

                    // Show intro
                    const intro = document.getElementById('introScreen');
                    intro.style.display = 'flex';
                    intro.style.opacity = '1';
                }




                function openCity(cityCode) {
                    window.location.href = 'map.html';
                }

                // ESC Key Navigation (for Guest mode)
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        const mainMenu = document.getElementById('mainMenuScreen');
                        const charSelect = document.getElementById('menuScreen');
                        const playerMenu = document.getElementById('playerMenuScreen');

                        // If in character select (guest mode), return to intro
                        if (charSelect.style.display === 'flex') {
